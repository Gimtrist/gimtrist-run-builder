4:["$","p","Games, achievements, communities, events, leaderboards, and the AI Companion are planned as connected modules. A player might discover a game through a recommendation, unlock an achievement, compare progress, and join a relevant discussion without feeling as though they have moved between unrelated products.",{"children":"Games, achievements, communities, events, leaderboards, and the AI Companion are planned as connected modules. A player might discover a game through a recommendation, unlock an achievement, compare progress, and join a relevant discussion without feeling as though they have moved between unrelated products."}]
5:["$","ul",null,{"className":"mt-6 grid gap-3 sm:grid-cols-2","children":[["$","li","Games remain the center",{"className":"rounded-2xl border border-[rgb(var(--accent-1)/0.2)] bg-[rgb(var(--accent-1)/0.06)] px-4 py-3 text-sm font-medium","children":"Games remain the center"}],["$","li","Every module has a clear player benefit",{"className":"rounded-2xl border border-[rgb(var(--accent-1)/0.2)] bg-[rgb(var(--accent-1)/0.06)] px-4 py-3 text-sm font-medium","children":"Every module has a clear player benefit"}],["$","li","Motion supports understanding",{"className":"rounded-2xl border border-[rgb(var(--accent-1)/0.2)] bg-[rgb(var(--accent-1)/0.06)] px-4 py-3 text-sm font-medium","children":"Motion supports understanding"}],["$","li","Real data replaces fabricated activity",{"className":"rounded-2xl border border-[rgb(var(--accent-1)/0.2)] bg-[rgb(var(--accent-1)/0.06)] px-4 py-3 text-sm font-medium","children":"Real data replaces fabricated activity"}]]}]
6:["$","section","Quality before page count",{"className":"glass rounded-3xl p-6 sm:p-8","children":[["$","h2",null,{"className":"font-heading text-2xl font-bold sm:text-3xl","children":"Quality before page count"}],["$","div",null,{"className":"mt-5 space-y-4 text-base leading-8 text-muted-foreground sm:text-lg","children":[["$","p","The project is being rebuilt around purposeful, production-ready experiences. Placeholder pages, invented statistics, and repetitive layouts may make a site look larger, but they do not make it more useful.",{"children":"The project is being rebuilt around purposeful, production-ready experiences. Placeholder pages, invented statistics, and repetitive layouts may make a site look larger, but they do not make it more useful."}],["$","p","The standard is simple: a feature should not be presented publicly until its content, interaction, responsive behavior, accessibility, and backend path have been considered together.",{"children":"The standard is simple: a feature should not be presented publicly until its content, interaction, responsive behavior, accessibility, and backend path have been considered together."}]]}],"$undefined"]}]

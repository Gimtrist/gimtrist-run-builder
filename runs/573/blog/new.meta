{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/blog/layout,_N_T_/blog/new/layout,_N_T_/blog/new/page,_N_T_/blog/new"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/blog/new/__PAGE__",
    "/blog/new",
    "/blog",
    "/_index",
    "/_head"
  ]
}
0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"id":"vision-overview","className":"relative scroll-mt-32","children":[["$","$L2",null,{"eyebrow":"The Vision","title":["Browser gaming deserves a ",["$","span",null,{"className":"text-gradient","children":"better home"}]],"subtitle":"A manifesto for what instant play could be — and why we are building Gaming Horizon."}],["$","section",null,{"className":"px-4 pb-8","children":["$","div",null,{"className":"mx-auto max-w-3xl","children":["$","$L3",null,{"children":["$","div",null,{"className":"glass rounded-3xl p-8 md:p-10","children":[["$","p",null,{"className":"text-lg leading-relaxed text-muted-foreground","children":[["$","span",null,{"className":"font-heading text-foreground","children":"Browser gaming is the most accessible way to play"}]," — no downloads, no installs, no expensive hardware. Yet for over a decade the experience around it has stayed broken. Games are scattered across dated portals buried in ads. Progress never follows you. Discovery is a slot machine. Communities are an afterthought."]}],["$","p",null,{"className":"mt-5 text-lg leading-relaxed text-muted-foreground","children":"Gaming Horizon exists to fix this. We are building a single, premium home for discovery, play, community, progression and AI — designed with the craft of a modern product, not the clutter of a legacy portal. A place where you click and play, where an AI companion understands how you want to spend your time, and where your identity and achievements are yours across every game."}],["$","p",null,{"className":"mt-5 text-lg leading-relaxed text-foreground","children":"This is not a games list. It is an ecosystem — and it deserves to be built properly."}]]}]}]}]}],["$","section",null,{"className":"px-4 py-16","children":["$","div",null,{"className":"mx-auto max-w-6xl","children":[["$","h2",null,{"className":"mb-10 text-center font-heading text-2xl font-semibold sm:text-3xl","children":"Our design philosophy"}],["$","div",null
7:["$","div",null,{"className":"flex min-h-screen flex-col items-center","children":["$","div",null,{"className":"flex w-full max-w-[1000px] flex-1 flex-col","children":[["$","$L10",null,{"visible":true}],["$","div",null,{"className":"flex flex-col gap-6 px-4 py-4 lg:px-10","children":[["$","p",null,{"children":["Welcome to Republic of Rome Online, the online adaptation of the board game"," ",["$","a",null,{"className":"text-blue-600 hover:underline","href":"https://boardgamegeek.com/boardgame/1513","children":"The Republic of Rome"}]," ","for 3 to 6 players."]}],["$","p",null,{"children":"This semi-cooperative political strategy game is set in the historical Roman Republic. Rival factions of senators compete for influence and prestige within a corrupt oligarchy, while collectively holding together a republic perpetually on the brink of collapse. If Rome falls, everyone loses — though that never seems to stop factions from stabbing each other in the back anyway, sometimes literally. Every faction is ultimately angling for the same thing: seizing power as Rome's first emperor in all but name."}],["$","div",null,{"className":"my-2 flex flex-col gap-4 rounded bg-neutral-100 px-8 py-6","children":[["$","h2",null,{"className":"text-lg","children":"Before you play"}],["$","ul",null,{"className":"flex list-disc flex-col gap-2 pl-8","children":[["$","li",null,{"children":"Sign in to browse and create games (a minimum of 3 players is required to start)"}],["$","li",null,{"children":"For the best experience, play with 5 or 6 players in real time while on a Discord voice call"}],["$","li",null,{"children":["The early republic scenario is the only one currently available, and it's playable but not yet feature-complete. See the"," ",["$","a",null,{"className":"text-blue-600 hover:underline","href":"https://github.com/iamlogand/republic-of-rome-online?tab=readme-ov-file#feature-checklist-early-republic-scenario","children":"feature checklist"}]," ","for a full breakdown."]}],["$","li",null,{"children":"The UI is functional but bare-bones for now. A full visual overhaul, including tooltips, icons, artwork, and a proper color scheme, is planned for a later stage of development."}],["$","li",null,{"children":["Bugs are expected, so please report any you encounter via"," ",["$","a",null,{"className":"text-blue-600 hover:underline","href":"https://github.com/iamlogand/republic-of-rome-online/issues","children":"GitHub Issues"}]]}]]}]]}]]}],["$","div",null,{"className":"mt-auto flex justify-center","children":["$","p",null,{"className":"px-4 py-4 text-center text-sm text-neutral-600 lg:px-10","children":["This is an open source project available on"," ",["$","a",null,{"className":"text-blue-600 hover:underline","href":"https://github.com/iamlogand/republic-of-rome-online","children":"GitHub"}],". Not affiliated with or endorsed by Avalon Hill or Hasbro."]}]}]]}]}]
